# Social Graph & Trust Intelligence Platform — Local Configuration Template
# Copy to .env for local customization. Never commit real secrets.

SGTI_RUNTIME_MODE=local_native
SGTI_DATA_DIR=.local_data
SGTI_API_HOST=127.0.0.1
SGTI_API_PORT=8050
SGTI_LOG_LEVEL=INFO

# Local development RBAC API keys (replace with secret manager injection in production)
SGTI_VIEWER_API_KEY=dev-viewer-key-local-only
SGTI_ANALYST_API_KEY=dev-analyst-key-local-only
SGTI_ADMIN_API_KEY=dev-admin-key-local-only

# Graph partitioning & sketch parameters
SGTI_NUM_PARTITIONS=16
SGTI_SUPERNODE_DEGREE_THRESHOLD=80
SGTI_SUPERNODE_SALT_BUCKETS=8
SGTI_HLL_PRECISION=10
SGTI_CMS_DEPTH=5
SGTI_CMS_WIDTH=2048

# Optional distributed stack settings (used when running docker-compose.yml profiles)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APICURIO_REGISTRY_URL=http://localhost:8081
ICEBERG_CATALOG_URI=http://localhost:8181/catalog
RUSTFS_ENDPOINT=http://localhost:9000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=social_graph_oltp
POSTGRES_USER=sgti_app
POSTGRES_PASSWORD=change-me-local-only
OTEL_ARCH=arm64
